<?xml version="1.0" encoding="utf-8"?>
<odoo>

    <!--
        Adds a "Launchmind Blog" block to the Website settings page.
        Lives under Settings > Website (parent module = website).
    -->
    <record id="res_config_settings_view_form_launchmind" model="ir.ui.view">
        <field name="name">res.config.settings.view.form.inherit.launchmind</field>
        <field name="model">res.config.settings</field>
        <field name="inherit_id" ref="website.res_config_settings_view_form"/>
        <field name="arch" type="xml">

            <xpath expr="//block[@id='website_info_settings']" position="after">
                <block title="Launchmind Blog" name="launchmind_blog_settings">
                    <setting id="launchmind_blog_intro"
                             string="Launchmind Blog"
                             help="Connect this Odoo Website to Launchmind to receive AI-generated, GEO-optimized blog articles automatically.">
                        <div class="content-group">
                            <div class="row mt8">
                                <label for="launchmind_api_key" class="col-lg-3 o_light_label"/>
                                <field name="launchmind_api_key" password="True" placeholder="lm_live_..."/>
                            </div>
                            <div class="row">
                                <label for="launchmind_api_base" class="col-lg-3 o_light_label"/>
                                <field name="launchmind_api_base"/>
                            </div>
                            <div class="row mt16">
                                <div class="col-lg-12">
                                    <field name="launchmind_connected" invisible="1"/>
                                    <button name="action_launchmind_connect"
                                            string="Connect"
                                            type="object"
                                            class="btn-primary"
                                            invisible="launchmind_connected"/>
                                    <button name="action_launchmind_disconnect"
                                            string="Disconnect"
                                            type="object"
                                            class="btn-secondary"
                                            invisible="not launchmind_connected"/>
                                </div>
                            </div>
                            <div class="row mt8" invisible="not launchmind_connected">
                                <div class="col-lg-12 text-success">
                                    <i class="fa fa-check-circle"/>
                                    Connected since
                                    <field name="launchmind_connected_at" nolabel="1" readonly="1" class="oe_inline"/>
                                </div>
                            </div>
                            <div class="row mt8">
                                <div class="col-lg-12 text-muted small">
                                    <i class="fa fa-info-circle"/>
                                    Don't have an account yet?
                                    <a href="https://launchmind.io" target="_blank">Sign up at launchmind.io</a>
                                    — your API key is in
                                    <em>Dashboard &gt; Settings &gt; API</em>.
                                </div>
                            </div>
                        </div>
                    </setting>
                </block>
            </xpath>
        </field>
    </record>

</odoo>
