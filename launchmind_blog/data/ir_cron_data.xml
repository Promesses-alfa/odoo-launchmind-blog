<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <data noupdate="1">
        <!-- Each run is bounded; with every feature off it makes no request. -->
        <record id="ir_cron_launchmind_discovery" model="ir.cron">
            <field name="name">Launchmind: discovery evidence and IndexNow</field>
            <field name="model_id" ref="model_launchmind_blog_url"/>
            <field name="state">code</field>
            <field name="code">model._cron_refresh_and_notify()</field>
            <field name="interval_number">15</field>
            <field name="interval_type">minutes</field>
            <field name="active" eval="True"/>
        </record>
        <record id="ir_cron_launchmind_health" model="ir.cron">
            <field name="name">Launchmind: daily health report</field>
            <field name="model_id" ref="model_launchmind_blog_url"/>
            <field name="state">code</field>
            <field name="code">model._cron_send_daily_health()</field>
            <field name="interval_number">1</field>
            <field name="interval_type">days</field>
            <field name="active" eval="True"/>
        </record>
    </data>
</odoo>
